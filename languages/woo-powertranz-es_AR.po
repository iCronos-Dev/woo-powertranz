msgstr "Código de Autorización:"

#: includes/class-woo-powertranz-admin-order.php
msgid "Response Code:"
msgstr "Código de Respuesta:"

#: includes/class-woo-powertranz-admin-order.php
msgid "Decline Details:"
msgstr "Detalles del Rechazo:"

#: includes/class-woo-powertranz-admin-order.php
msgid "Code: %s"
msgstr "Código: %s"

#: includes/class-woo-powertranz-admin-order.php
msgid "Error Details:"
msgstr "Detalles del Error:"

#: includes/class-woo-powertranz-admin-order.php
msgid "No transaction data available."
msgstr "No hay datos de transacción disponibles."

#: includes/class-woo-powertranz-admin-order.php
msgid "Captured"
msgstr "Capturado"

#: includes/class-woo-powertranz-admin-order.php
msgid "Authorized"
msgstr "Autorizado"

#: includes/class-woo-powertranz-admin-order.php
msgid "Declined"
msgstr "Rechazado"

#: includes/class-woo-powertranz-admin-order.php
msgid "Error"
msgstr "Error"

#: includes/class-woo-powertranz-admin-order.php
